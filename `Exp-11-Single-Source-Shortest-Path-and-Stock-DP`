#1. Dijkstra’s Algorithm

#include <stdio.h>

#define MAX 100
#define INF 999999

void dijkstra(int graph[MAX][MAX], int n, int source) {
    int dist[MAX], visited[MAX] = {0};
    int i, j, u, min;

    for (i = 0; i < n; i++)
        dist[i] = INF;

    dist[source] = 0;

    for (i = 0; i < n - 1; i++) {
        min = INF;
        u = -1;

        for (j = 0; j < n; j++) {
            if (!visited[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (j = 0; j < n; j++) {
            if (!visited[j] && graph[u][j] > 0 &&
                dist[u] + graph[u][j] < dist[j]) {
                dist[j] = dist[u] + graph[u][j];
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n", source);

    for (i = 0; i < n; i++) {
        if (dist[i] == INF)
            printf("Vertex %d: Unreachable\n", i);
        else
            printf("Vertex %d: %d\n", i, dist[i]);
    }
}

int main() {
    int graph[MAX][MAX];
    int n, source, i, j;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix (0 means no edge):\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("Enter source vertex (0 to %d): ", n - 1);
    scanf("%d", &source);

    if (n <= 0 || n > MAX || source < 0 || source >= n) {
        printf("Invalid input.\n");
        return 1;
    }

    dijkstra(graph, n, source);

    return 0;
}
#Buy and Sell Stocks with Transaction Fee (Dynamic Programming)

#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int maxProfit(int prices[], int n, int fee) {
    int hold = -prices[0];
    int cash = 0;
    int prevCash, i;

    for (i = 1; i < n; i++) {
        prevCash = cash;

        cash = max(cash, hold + prices[i] - fee);
        hold = max(hold, prevCash - prices[i]);
    }

    return cash;
}

int main() {
    int n, fee, i;
    int prices[1000];

    printf("Enter number of days: ");
    scanf("%d", &n);

    if (n <= 0 || n > 1000) {
        printf("Invalid number of days.\n");
        return 1;
    }

    printf("Enter stock prices:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &prices[i]);

    printf("Enter transaction fee: ");
    scanf("%d", &fee);

    if (fee < 0) {
        printf("Invalid transaction fee.\n");
        return 1;
    }

    printf("Maximum profit: %d\n", maxProfit(prices, n, fee));

    return 0;
}
