                    printf("Invalid array size.\n");
                    break;
                }

                printf("Enter array elements: ");
                for (int i = 0; i < n; i++)
                    scanf("%d", &arr[i]);

                printf("Maximum product: %lld\n",
                       maxProduct(arr, n));
                break;

            case 2:
                printf("Enter array size: ");
                scanf("%d", &n);

                if (n < 1 || n > MAX) {
                    printf("Invalid array size.\n");
                    break;
                }

                printf("Enter array elements: ");
                for (int i = 0; i < n; i++)
                    scanf("%d", &arr[i]);

                printf("Enter K (1 to %d): ", n);
                scanf("%d", &k);

                if (k < 1 || k > n) {
                    printf("Invalid value of K.\n");
                    break;
                }

                printf("Kth largest element: %d\n",
                       quickSelect(arr, 0, n - 1, k - 1));
                break;

            case 3:
                printf("Enter n (0 to 92): ");
                scanf("%d", &n);

                if (n < 0 || n > 92) {
                    printf("Invalid value of n.\n");
                    break;
                }

                for (int i = 0; i <= 92; i++)
                    fibMemo[i] = -1;

                printf("Fibonacci number: %lld\n",
