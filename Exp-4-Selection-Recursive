                break;

            case 4:
                printf("Enter array size: ");
                scanf("%d", &n);

                if (n < 1 || n > MAX) {
                    printf("Invalid array size.\n");
                    break;
                }

                printf("Enter array elements: ");
                for (int i = 0; i < n; i++)
                    scanf("%d", &arr[i]);

                printf("Original array: ");
                displayArray(arr, n);

                printf("Smallest missing positive integer: %d\n",
                       smallestMissingPositive(arr, n));
                break;

            case 0:
                printf("Program terminated.\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
        }

    } while (choice != 0);

    return 0;
}
